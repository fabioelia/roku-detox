<?xml version="1.0" encoding="utf-8"?>
<!--
  Detox Home main scene (FHD 1920x1080). Needs no computer: the apps come from the TV itself.
  Fields set by source/main.brs:
    seed     = what Roku Detox put in pkg:/config.json ({seed, favorites, clock24, simpleMode, tvName}), or {}
    deepLink = {contentId, mediaType, seq, ...}  (launch args or roInputEvent)
-->
<component name="HomeScene" extends="Scene">
  <interface>
    <field id="seed" type="assocarray" onChange="onSeed"/>
    <field id="deepLink" type="assocarray" alwaysNotify="true" onChange="onDeepLink"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/HomeScene.brs"/>
  <script type="text/brightscript" uri="pkg:/components/DetoxUtils.brs"/>
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x10161FFF"/>

    <!-- Home screen -->
    <Group id="homeGroup">
      <!-- Rows of tiles (Favorites, All apps, Inputs); built in HomeScene.brs, scrolls up and down -->
      <Group id="rowsArea" translation="[0,330]"/>

      <!-- Drawn over the rows so a row scrolling up never covers the clock -->
      <Rectangle id="topCover" width="1920" height="320" color="0x10161FFF"/>
      <Label id="clockLabel" translation="[120,60]" width="1000" color="0xEEF2F6FF" font="font:LargeBoldSystemFont"/>
      <Label id="dateLabel" translation="[124,210]" width="1000" color="0x8D9AA8FF" font="font:LargeSystemFont"/>
      <Label id="tvNameLabel" translation="[1000,80]" width="800" horizAlign="right" color="0x5F6D7CFF" font="font:LargeSystemFont"/>
      <Label id="hintLabel" translation="[1000,132]" width="800" horizAlign="right" color="0x5F6D7CFF" font="font:LargeSystemFont"/>

      <Label id="statusLabel" translation="[120,410]" width="1680" wrap="true" color="0x8D9AA8FF" text="Loading your apps…" font="font:LargeSystemFont"/>
      <Label id="emptyLabel" translation="[120,410]" width="1680" wrap="true" visible="false" color="0xC9D3DDFF" text="No apps found on this TV." font="font:LargeSystemFont"/>
    </Group>

    <!-- Short notes: "Added Netflix to favorites" -->
    <Rectangle id="banner" translation="[1040,190]" width="760" height="64" color="0x1F3A33FF" visible="false">
      <Label id="bannerLabel" width="760" height="64" horizAlign="center" vertAlign="center" color="0xCFF5EAFF" font="font:LargeSystemFont"/>
    </Rectangle>

    <MessageView id="messageView" visible="false"/>
    <SearchView id="searchView" visible="false"/>
    <VideoView id="videoView" visible="false"/>

    <!-- "Opening Netflix…" and problems opening an app -->
    <Group id="overlay" visible="false">
      <Rectangle width="1920" height="1080" color="0x0A0E14E6"/>
      <Label id="overlayTitle" translation="[160,400]" width="1600" horizAlign="center" color="0xFFFFFFFF" font="font:LargeBoldSystemFont"/>
      <Label id="overlayText" translation="[160,520]" width="1600" horizAlign="center" wrap="true" color="0xC9D3DDFF" font="font:LargeSystemFont"/>
    </Group>

    <Timer id="clockTimer" duration="1" repeat="true"/>
    <Timer id="refreshTimer" duration="60" repeat="true"/>
    <Timer id="overlayTimer" duration="15" repeat="false"/>
    <Timer id="bannerTimer" duration="3" repeat="false"/>
  </children>
</component>
