{
  "manifest_version": 3,
  "name": "Roku Detox",
  "version": "1.3.0",
  "description": "Control and clean up your Roku TV from the browser: remote, find a show, rules, and send videos to the TV. No program at home needed.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Roku Detox",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "app/index.html"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "webRequest",
    "declarativeNetRequest",
    "tabs",
    "scripting",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "omnibox": {
    "keyword": "tv"
  },
  "commands": {
    "play-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "MacCtrl+Shift+P"
      },
      "description": "Play or pause the TV"
    },
    "send-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Send this tab's video to the TV"
    },
    "volume-up": {
      "suggested_key": {
        "default": "Alt+Shift+Period",
        "mac": "MacCtrl+Shift+Period"
      },
      "description": "Turn the TV's volume up"
    },
    "volume-down": {
      "suggested_key": {
        "default": "Alt+Shift+Comma",
        "mac": "MacCtrl+Shift+Comma"
      },
      "description": "Turn the TV's volume down"
    },
    "mute": {
      "description": "Mute or unmute the TV"
    },
    "tv-home": {
      "description": "Go to the TV's home screen"
    },
    "tv-back": {
      "description": "Go back on the TV"
    }
  }
}
